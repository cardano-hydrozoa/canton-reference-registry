module Splice.Tests.TestHydrozoaTreasury where

import Daml.Script

import DA.Assert
import DA.List (head)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2

import Splice.TokenStandard.Utils

import Splice.Testing.Utils
import Splice.Testing.Registries.TestTokenV2_RegistryV2 qualified as TestTokenV2_RegistryV2
import Splice.Testing.Registries.TestRegistries qualified as TestRegistries
import Splice.Testing.TokenStandard.MultiRegistry qualified as MultiRegistry
import Splice.Testing.TokenStandard.RegistryApiV2 qualified as V2
import Splice.Testing.TokenStandard.WalletClientV2 qualified as WalletClientV2


test : Script ()
test = setup >>= hydrozoaTreasuryFlow

data TestCase = TestCase with
  env : TestRegistries.Env
  provider : Party
  alice : Party
  bob : Party
  hydrozoa : Party
  instrIds : [V2.InstrumentId]
  registry : V2.GenericRegistry

getAdmin : TestCase -> Party
getAdmin tc = tc.env.testTokenV2.admin


-- Cribbed from TestIteratedSettlement.daml
setup : Script TestCase
setup = do
  env <- TestRegistries.initialize TestRegistries.defaultConfig
  provider <- allocateParty "provider"
  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  hydrozoa <- allocateParty "hydrozoa"
  let admin = env.testTokenV2.admin
  let xId = V2.InstrumentId with
        id = "X"
        admin
  let yId = V2.InstrumentId with
        id = "Y"
        admin
  TestTokenV2_RegistryV2.mint env.testTokenV2 (basicAccount alice) "X" 1000.0
  TestTokenV2_RegistryV2.mint env.testTokenV2 (basicAccount bob) "Y" 1000.0
  registry <- MultiRegistry.getRegistryApiV2 env.registries admin

  pure TestCase with
    env
    provider
    alice
    bob
    hydrozoa
    instrIds = [xId, yId]
    registry

-- | A Hydrozoa-style head modelled on the token standard:
--   1. Alice deposits 100 X and Bob deposits 100 Y into a committed, iterated
--      "treasury" allocation authorized by the `hydrozoa` operator.
--   2. An L2 trade happens off-ledger (Alice and Bob swap X <-> Y).
--   3. The operator settles the head, paying Alice 100 Y and Bob 100 X and
--      closing the pool.
-- `hydrozoa` plays the settlement `executor` throughout; in a real head this
-- would be a multisig/quorum rather than a single party.
hydrozoaTreasuryFlow : TestCase -> Script ()
hydrozoaTreasuryFlow tc =
  let
    admin = getAdmin tc
    xId = V2.InstrumentId with
      id = "X"
      admin
    yId = V2.InstrumentId with
      id = "Y"
      admin

    settlement = V2.SettlementInfo with
      executors = [tc.hydrozoa]
      id = "hydrozoa-head/demo"
      cid = None
      meta = emptyMetadata

    mkLeg : Text -> V2.Account -> V2.Account -> Text -> V2.TransferLeg
    mkLeg legId sender receiver instrId = V2.TransferLeg with
      transferLegId = legId
      sender
      receiver
      amount = 100.0
      instrumentId = instrId
      meta = emptyMetadata

    -- deposit legs (into the treasury) and payout legs (out of it, swapped)
    aliceDepositLeg = mkLeg "alice-deposit" (basicAccount tc.alice) (basicAccount tc.hydrozoa) "X"
    bobDepositLeg   = mkLeg "bob-deposit"   (basicAccount tc.bob)   (basicAccount tc.hydrozoa) "Y"
    alicePayoutLeg  = mkLeg "alice-payout"  (basicAccount tc.hydrozoa) (basicAccount tc.alice) "Y"
    bobPayoutLeg    = mkLeg "bob-payout"    (basicAccount tc.hydrozoa) (basicAccount tc.bob)   "X"

    -- Smart constructor with shared defaults (single-shot, uncommitted).
    mkAlloc : V2.Account -> [V2.TransferLegSide] -> V2.AllocationSpecification
    mkAlloc authorizer transferLegSides = V2.AllocationSpecification with
      authorizer
      admin
      transferLegSides
      settlementDeadline = None
      nextIterationFunding = None
      committed = False
      meta = emptyMetadata

    -- single-shot allocations: authorize (and, for senders, lock) one side each
    aliceDepositAlloc = mkAlloc (basicAccount tc.alice) [senderSide aliceDepositLeg]
    bobDepositAlloc   = mkAlloc (basicAccount tc.bob)   [senderSide bobDepositLeg]
    aliceReceiveAlloc = mkAlloc (basicAccount tc.alice) [receiverSide alicePayoutLeg]
    bobReceiveAlloc   = mkAlloc (basicAccount tc.bob)   [receiverSide bobPayoutLeg]

    -- the pooled treasury allocation: iterated + committed, with no legs of its
    -- own; the operator finalizes the concrete legs at settlement time.
    treasuryAlloc = (mkAlloc (basicAccount tc.hydrozoa) []) with
      nextIterationFunding = Some TextMap.empty
      committed = True
  in
    do
      now <- getTime

      -- helpers (close over `now`, `settlement`, `tc`, `admin`)
      let
        createAlloc : Party -> V2.AllocationSpecification -> [ContractId V2.Holding]
                   -> Script (ContractId V2.Allocation)
        createAlloc authorizer spec inputs = do
          ec <- V2.getAllocationFactory tc.registry V2.AllocationFactory_Allocate with
            settlement
            allocation = spec
            requestedAt = now
            inputHoldingCids = inputs
            actors = [authorizer]
            extraArgs = emptyExtraArgs
          res <- WalletClientV2.submitAndCheckTxHistory [admin]
            (actAs authorizer <> discloseMany' ec.disclosures) $
            exerciseCmd ec.factoryCid ec.arg
          let V2.AllocationInstructionResult_Completed cid = res.output
          pure cid

        settleBatch : [V2.TransferLeg] -> [V2.FinalizedAllocation]
                   -> Script V2.SettlementFactory_SettleBatchResult
        settleBatch legs allocs = do
          ec <- V2.getSettlementFactory tc.registry V2.SettlementFactory_SettleBatch with
            actors = [tc.hydrozoa]        -- the executor settles; must equal settlement.executors
            settlement
            transferLegs = legs
            allocations = allocs
            extraArgs = emptyExtraArgs
          WalletClientV2.submitAndCheckTxHistory [admin]
            (actAs tc.hydrozoa <> discloseMany' ec.disclosures) $
            exerciseCmd ec.factoryCid ec.arg

      -- 1. deposits ----------------------------------------------------------
      aliceInputs <- concat <$> forA tc.instrIds (WalletClientV2.listHoldingCids tc.alice)
      bobInputs   <- concat <$> forA tc.instrIds (WalletClientV2.listHoldingCids tc.bob)

      aliceDepositCid <- createAlloc tc.alice    aliceDepositAlloc aliceInputs
      bobDepositCid   <- createAlloc tc.bob      bobDepositAlloc   bobInputs
      treasuryCid0    <- createAlloc tc.hydrozoa treasuryAlloc     []

      -- Operator settles: Alice's and Bob's funds move into the pooled treasury
      -- allocation, whose reserved funding rolls forward to hold them.
      -- Treasury is listed first, so `head` picks up its settle result.
      depositResult <- settleBatch [aliceDepositLeg, bobDepositLeg]
        [ V2.FinalizedAllocation with
            allocationCid = treasuryCid0
            extraTransferLegSides = [receiverSide aliceDepositLeg, receiverSide bobDepositLeg]
            nextIterationFunding = Some (TextMap.fromList [("X", 100.0), ("Y", 100.0)])
        , nonIteratedAllocation aliceDepositCid
        , nonIteratedAllocation bobDepositCid
        ]
      let Some treasuryCid1 =
            WalletClientV2.extractNextIterationAllocationCid (head depositResult.allocationSettleResults)

      -- 2. L2 trade happens off-ledger: Alice and Bob swap X <-> Y -----------

      -- 3. withdrawal --------------------------------------------------------
      -- Each withdrawer signals intent by authorizing receipt of their payout.
      aliceReceiveCid <- createAlloc tc.alice aliceReceiveAlloc []
      bobReceiveCid   <- createAlloc tc.bob   bobReceiveAlloc   []

      -- Operator pays out the swapped instruments and closes the pool
      -- (nextIterationFunding = None ends iteration).
      _ <- settleBatch [alicePayoutLeg, bobPayoutLeg]
        [ V2.FinalizedAllocation with
            allocationCid = treasuryCid1
            extraTransferLegSides = [senderSide alicePayoutLeg, senderSide bobPayoutLeg]
            nextIterationFunding = None
        , nonIteratedAllocation aliceReceiveCid
        , nonIteratedAllocation bobReceiveCid
        ]

      -- 4. assertions: the swap took effect and value is conserved -----------
      WalletClientV2.checkUnlockedBalance tc.alice xId 900.0
      WalletClientV2.checkUnlockedBalance tc.alice yId 100.0
      WalletClientV2.checkUnlockedBalance tc.bob   yId 900.0
      WalletClientV2.checkUnlockedBalance tc.bob   xId 100.0

      -- the treasury pool is closed
      remainingTreasuryAllocs <- queryInterface @V2.Allocation tc.hydrozoa
      remainingTreasuryAllocs === []

      pure ()
