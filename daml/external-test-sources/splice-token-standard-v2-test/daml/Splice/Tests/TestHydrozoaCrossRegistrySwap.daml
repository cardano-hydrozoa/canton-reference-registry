-- | Demo: an atomic cross-REGISTRY swap, hydrozoa-framed.
--
-- Two *different* registries (distinct admin parties), each issuing its own
-- instrument: registryX issues X, registryY issues Y. Alice holds X, Bob holds Y.
-- The operator settles a swap (Alice's 100 X <-> Bob's 100 Y) atomically, even
-- though the two instruments come from different registries.
--
-- The atomicity trick (no cross-synchronizer needed): each registry's
-- SettlementFactory settles its own leg, and both exercises are submitted in a
-- SINGLE submission — Daml commits all commands in a submission as one
-- transaction, so the swap is all-or-nothing across both registries. This is the
-- same shape as `TestSettlement_V1V2Mixed`'s bilateral DvP, minus the trading-app
-- venue machinery.
module Splice.Tests.TestHydrozoaCrossRegistrySwap where

import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.AllocationInstructionV2 qualified as V2
import Splice.Api.Token.HoldingV2 qualified as V2

import Splice.TokenStandard.Utils

import Splice.Testing.Utils
import Splice.Testing.Registries.TestTokenV2_RegistryV2 qualified as TestTokenV2_RegistryV2
import Splice.Testing.TokenStandard.RegistryApiV2 qualified as V2
import Splice.Testing.TokenStandard.WalletClientV2 qualified as WalletClientV2


-- | Assert a party's unlocked balance of an instrument.
checkBalance : Party -> V2.InstrumentId -> Decimal -> Script ()
checkBalance p instrumentId expected =
  WalletClientV2.checkUnlockedBalance p instrumentId expected

test : Script ()
test = do
  -- Two independent registries on the same ledger, each with its own admin party.
  regX <- TestTokenV2_RegistryV2.initialize
    (TestTokenV2_RegistryV2.TestTokenV2RegistryConfig with adminPartyName = "registryX")
  regY <- TestTokenV2_RegistryV2.initialize
    (TestTokenV2_RegistryV2.TestTokenV2RegistryConfig with adminPartyName = "registryY")
  let genX = V2.mkGenericRegistry regX
      genY = V2.mkGenericRegistry regY
      adminX = regX.admin
      adminY = regY.admin

  alice <- allocateParty "alice"
  bob <- allocateParty "bob"
  operator <- allocateParty "operator"

  let xId = V2.InstrumentId with id = "X", admin = adminX
      yId = V2.InstrumentId with id = "Y", admin = adminY

  -- Alice holds X (from registryX); Bob holds Y (from registryY).
  TestTokenV2_RegistryV2.mint regX (basicAccount alice) "X" 1000.0
  TestTokenV2_RegistryV2.mint regY (basicAccount bob) "Y" 1000.0

  now <- getTime

  let settlement = V2.SettlementInfo with
        executors = [operator]
        id = "hydrozoa-cross-registry-swap/demo"
        cid = None
        meta = emptyMetadata

      mkLeg : Text -> V2.Account -> V2.Account -> Text -> V2.TransferLeg
      mkLeg transferLegId sender receiver instrumentId = V2.TransferLeg with
        transferLegId
        sender
        receiver
        amount = 100.0
        instrumentId
        meta = emptyMetadata

      xLeg = mkLeg "alice-x-to-bob" (basicAccount alice) (basicAccount bob) "X"
      yLeg = mkLeg "bob-y-to-alice" (basicAccount bob) (basicAccount alice) "Y"

      mkAlloc : Party -> Party -> [V2.TransferLegSide] -> V2.AllocationSpecification
      mkAlloc admin authorizer transferLegSides = V2.AllocationSpecification with
        authorizer = basicAccount authorizer
        admin
        transferLegSides
        settlementDeadline = None
        nextIterationFunding = None
        committed = False
        meta = emptyMetadata

  -- Off-ledger helper: create an allocation via a specific registry.
  let createAlloc
        : V2.GenericRegistry -> Party -> Party -> V2.AllocationSpecification
       -> [ContractId V2.Holding] -> Script (ContractId V2.Allocation)
      createAlloc registry admin authorizer spec inputs = do
        ec <- V2.getAllocationFactory registry V2.AllocationFactory_Allocate with
          settlement
          allocation = spec
          requestedAt = now
          inputHoldingCids = inputs
          actors = [authorizer]
          extraArgs = emptyExtraArgs
        res <- WalletClientV2.submitAndCheckTxHistory [admin]
          (actAs authorizer <> discloseMany' ec.disclosures) $
          exerciseCmd ec.factoryCid ec.arg
        let V2.AllocationInstructionResult_Completed cid = res.output
        pure cid

  -- Each leg needs the sender to lock+authorize, and the receiver to authorize receipt.
  aliceInputsX <- WalletClientV2.listHoldingCids alice xId
  bobInputsY <- WalletClientV2.listHoldingCids bob yId

  -- Preflight.
  checkBalance alice xId 1000.0
  checkBalance bob yId 1000.0
  checkBalance alice yId 0.0
  checkBalance bob xId 0.0

  aliceSendX <- createAlloc genX adminX alice (mkAlloc adminX alice [senderSide xLeg]) aliceInputsX
  bobRecvX <- createAlloc genX adminX bob (mkAlloc adminX bob [receiverSide xLeg]) []
  bobSendY <- createAlloc genY adminY bob (mkAlloc adminY bob [senderSide yLeg]) bobInputsY
  aliceRecvY <- createAlloc genY adminY alice (mkAlloc adminY alice [receiverSide yLeg]) []

  -- Atomic cross-registry settle: registryX settles the X leg, registryY settles the
  -- Y leg, both exercised in ONE submission -> one transaction -> all-or-nothing.
  ecX <- V2.getSettlementFactory genX V2.SettlementFactory_SettleBatch with
    actors = [operator]
    settlement
    transferLegs = [xLeg]
    allocations = [nonIteratedAllocation aliceSendX, nonIteratedAllocation bobRecvX]
    extraArgs = emptyExtraArgs
  ecY <- V2.getSettlementFactory genY V2.SettlementFactory_SettleBatch with
    actors = [operator]
    settlement
    transferLegs = [yLeg]
    allocations = [nonIteratedAllocation bobSendY, nonIteratedAllocation aliceRecvY]
    extraArgs = emptyExtraArgs

  -- One submission, two commands (`*>` combines them into a single transaction).
  _ <- WalletClientV2.submitAndCheckTxHistory [adminX, adminY]
    (actAs operator <> discloseMany' (ecX.disclosures <> ecY.disclosures)) $
    exerciseCmd ecX.factoryCid ecX.arg *> exerciseCmd ecY.factoryCid ecY.arg

  -- Post-swap: the instruments have crossed registries. Value is conserved.
  checkBalance alice xId 900.0
  checkBalance alice yId 100.0
  checkBalance bob yId 900.0
  checkBalance bob xId 100.0

  pure ()
